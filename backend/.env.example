# Copy to backend/.env. With TWITCH_MOCK=true (the dev compose default) only the POSTGRES_* values are needed.
PORT=8080

POSTGRES_USER=roulette
POSTGRES_PASSWORD=roulette
POSTGRES_DB=roulette

# Real Twitch integration (not needed when TWITCH_MOCK=true)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost/api/auth/callback
TWITCH_WEBHOOK_CALLBACK_URL=
# Used to verify EventSub webhook signatures. Required in production.
TWITCH_WEBHOOK_SECRET=

# Twitch user id of the broadcaster whose spins resolve predictions
TOKKI_USER_ID=

# Enables /api/debug/twitch/* routes
DEBUG=false
